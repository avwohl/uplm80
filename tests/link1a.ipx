declare ERR204 literally '0CCH';
declare ERR208 literally '0D0H';
declare ERR210 literally '0D2H';
declare ERR211 literally '0D3H';
declare LIBRARY$T literally 'STRUCTURE (link ADDRESS, modlist ADDRESS, publicsMode BYTE, hasModules BYTE, name(1) BYTE)';
declare R$COMDEF literally '2EH';
declare R$CONTENT literally '6';
declare RECORD$ST literally 'STRUCTURE (type BYTE, len ADDRESS, rec(1) BYTE)';
declare R$LIBDICT literally '2AH';
declare R$LIBLOCS literally '26H';
declare TRUE literally '0FFH';
declare actRead address external;
declare buf$p address external;
declare curModule address external;
declare curObjFile address external;
declare DUMMYREC(1) byte external;
declare ebuf$p address external;
declare erec$p address external;
declare inBlk address external;
declare inb$p address external;
declare inByt address external;
declare inCRC byte external;
declare inFile address external;
declare inFileName(1) byte external;
declare in$p address external;
declare inRecord$p address external;
declare membot address external;
declare npbuf address external;
declare recLen address external;
declare recNum address external;
declare sbuf$p address external;
declare statusIO address external;
declare toFileName(1) byte external;
declare topHeap address external;
Close: procedure(conn, status$p) external; declare conn address, status$p address; end;
FatalErr: procedure(errCode) external; declare errCode byte; end;
FileError: procedure(errCode, file, errExit) external;
    declare errCode address, file address, errExit byte;
end;
IllegalRelo: procedure external; end;
MemMov: procedure(cnt, srcp, dstp) external; declare cnt address, srcp address, dstp address; end;
Open: procedure(conn$p, path$p, access, echo, status$p) external;
    declare conn$p address, path$p address, access address, echo address, status$p address;
end;
Pstrcpy: procedure(psrc, pdst) external; declare psrc address, pdst address; end;
Read: procedure(conn, buff$p, count, actual$p, status$p) external;
    declare conn address, buff$p address, count address, actual$p address, status$p address;
end;
Seek: procedure(conn, mode, block$p, byte$p, status$p) external;
    declare conn address, mode address, block$p address, byte$p address, status$p address;
end;
declare inRecord based inRecord$p  RECORD$ST;
declare objFile based curObjFile  LIBRARY$T;
