T2: DO;
DECLARE (B1, B2, B3, B4, B5) BYTE;
DECLARE (A1, A2, A3, A4, A5) ADDRESS;
/* 2 params */
P2BB: PROCEDURE(X, Y) PUBLIC; DECLARE (X, Y) BYTE; B1 = X; B2 = Y; END P2BB;
P2AA: PROCEDURE(X, Y) PUBLIC; DECLARE (X, Y) ADDRESS; A1 = X; A2 = Y; END P2AA;
P2AB: PROCEDURE(X, Y) PUBLIC; DECLARE X ADDRESS, Y BYTE; A1 = X; B2 = Y; END P2AB;
P2BA: PROCEDURE(X, Y) PUBLIC; DECLARE X BYTE, Y ADDRESS; B1 = X; A2 = Y; END P2BA;
/* 3 params */
P3BBB: PROCEDURE(X, Y, Z) PUBLIC; DECLARE (X, Y, Z) BYTE; B1 = X; B2 = Y; B3 = Z; END P3BBB;
P3AAA: PROCEDURE(X, Y, Z) PUBLIC; DECLARE (X, Y, Z) ADDRESS; A1 = X; A2 = Y; A3 = Z; END P3AAA;
P3BAB: PROCEDURE(X, Y, Z) PUBLIC; DECLARE (X, Z) BYTE, Y ADDRESS; B1 = X; A2 = Y; B3 = Z; END P3BAB;
P3ABA: PROCEDURE(X, Y, Z) PUBLIC; DECLARE (X, Z) ADDRESS, Y BYTE; A1 = X; B2 = Y; A3 = Z; END P3ABA;
/* 4 params */
P4: PROCEDURE(W, X, Y, Z) PUBLIC; DECLARE (W, Y) BYTE, (X, Z) ADDRESS;
  B1 = W; A2 = X; B3 = Y; A4 = Z; END P4;
P4X: PROCEDURE(W, X, Y, Z) PUBLIC; DECLARE (W, Y) ADDRESS, (X, Z) BYTE;
  A1 = W; B2 = X; A3 = Y; B4 = Z; END P4X;
/* 5 params */
P5: PROCEDURE(V, W, X, Y, Z) PUBLIC; DECLARE (V, X, Z) BYTE, (W, Y) ADDRESS;
  B1 = V; A2 = W; B3 = X; A4 = Y; B5 = Z; END P5;
MAIN: PROCEDURE PUBLIC;
  CALL P2BB(B1, B2);
  CALL P2AA(A1, A2);
  CALL P2AB(A1, B2);
  CALL P2BA(B1, A2);
  CALL P3BBB(B1, B2, B3);
  CALL P3AAA(A1, A2, A3);
  CALL P3BAB(B1, A2, B3);
  CALL P3ABA(A1, B2, A3);
  CALL P4(B1, A2, B3, A4);
  CALL P4X(A1, B2, A3, B4);
  CALL P5(B1, A2, B3, A4, B5);
  CALL P5(7, 1234H, B1+B2, A1+A2, 9);
END MAIN;
END T2;
